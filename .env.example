# ====================== BEHAVIOUR ======================
MAX_HISTORY_TURNS=20
ADMIN_IDS=123456789
GROUP_MENTION_ONLY=true
USE_RICH_MESSAGES=true
AUTO_REMEMBER=true
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_QUOTA=200
MAX_TOKENS_SMALL=2048
MAX_TOKENS_MEDIUM=6144
MAX_TOKENS_BIG=16384
AUTO_REACT=true
AUTO_PROJECT_TITLE=true
ENABLE_SCHEDULER=true
SKILL_CHECK_MINUTES=1

