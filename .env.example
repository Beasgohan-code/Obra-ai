# ====================== TELEGRAM ======================
BOT_TOKEN=123456:AAF...from_BotFather
WEBAPP_URL=https://your-domain.com/app
MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# ====================== PRIMARY LLM ======================
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MODEL_CODER=
MODEL_RESEARCHER=
MODEL_WRITER=

# ====================== FREE / FALLBACK KEYS ======================
# Any of these are tried automatically if primary fails
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Optional JSON array of extra providers:
# FREE_FALLBACKS=[{"name":"custom","base_url":"https://...","api_key":"...","model":"..."}]
FREE_FALLBACKS=[]

# ====================== BEHAVIOUR ======================
MAX_HISTORY_TURNS=20
ADMIN_IDS=123456789
GROUP_MENTION_ONLY=true
USE_RICH_MESSAGES=true
AUTO_REMEMBER=true
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_QUOTA=200

# ====================== TOOLS ======================
SERPER_API_KEY=
TAVILY_API_KEY=
IMAGE_MODEL=dall-e-3
OPENWEATHER_API_KEY=

# ====================== DASHBOARD ======================
DASHBOARD_SECRET=change-me-to-random-string
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080


# ====================== GOOGLE (optional) ======================
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ====================== SCHEDULER ======================
ENABLE_SCHEDULER=true
SKILL_CHECK_MINUTES=15

# Vision / voice
VISION_MODEL=
WHISPER_MODEL=whisper-1
ENABLE_AUTO_FACTS=true

TTS_MODEL=tts-1

MAX_TOKENS_SMALL=2048
MAX_TOKENS_MEDIUM=6144
MAX_TOKENS_BIG=16384
AUTO_REACT=true
AUTO_PROJECT_TITLE=true

GITHUB_TOKEN=
WEBHOOK_INBOUND_SECRET=obra-inbound
ENABLE_SANDBOX=true
TOOL_MAX_RETRIES=2

WELCOME_PHOTO_URL=
CHANNEL_URL=
